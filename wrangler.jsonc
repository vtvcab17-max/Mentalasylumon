{
  // Bệnh viện tâm thần online — một Worker: client 3D (static assets) + API + Durable Objects
  "$schema": "node_modules/wrangler/config-schema.json",
  // Tên phải trùng với Worker trên Cloudflare (Workers Builds).
  "name": "mentalasylumon",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "apps/client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/ws/*", "/admin/*"]
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "benh-vien-dev", "database_id": "1c8ae363-563b-4881-9f5d-8ba99adec4ce", "migrations_dir": "apps/worker/migrations" }
  ],
  // R2 tạm tắt: tài khoản chưa bật R2 (Dashboard → R2). Bật lại khi cần tài sản 3D/audio (T057, T091).
  // "r2_buckets": [{ "binding": "ASSETS_BUCKET", "bucket_name": "benh-vien-assets-dev" }],

  "durable_objects": {
    "bindings": [
      { "name": "WORLD_ZONE", "class_name": "WorldZone" },
      { "name": "CIRCLE_ROOM", "class_name": "CircleRoom" },
      { "name": "LECTURE_HALL", "class_name": "LectureHall" },
      { "name": "PATIENT_RECORD", "class_name": "PatientRecord" },
      { "name": "KEY_VAULT", "class_name": "KeyVault" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorldZone", "CircleRoom", "LectureHall", "PatientRecord"] },
    { "tag": "v2", "new_sqlite_classes": ["KeyVault"] }
  ],

  "vars": {
    "APP_ENV": "dev",
    "AI_GATEWAY_ACCOUNT_ID": "",
    "AI_GATEWAY_ID": "benh-vien",
    // OAuth Client ID là công khai (hiện trong URL đăng nhập); Client SECRET đặt bằng secret, không ghi ở đây.
    "GOOGLE_CLIENT_ID": "48256280382-0l8nrv2s52ga660fe0u1leni5dobtfke.apps.googleusercontent.com"
  },
  // Secrets (wrangler secret put): ANTHROPIC_API_KEY, ELEVENLABS_API_KEY. Không cần Google secret
  // (đăng nhập bằng ID token). CHAT_ENCRYPTION_KEY tùy chọn: không đặt thì KeyVault tự tạo. Không bao giờ ghi vào file này (Constitution).

  "triggers": { "crons": ["17 19 * * *"] },

  "env": {
    "staging": {
      "vars": { "APP_ENV": "staging", "AI_GATEWAY_ACCOUNT_ID": "", "AI_GATEWAY_ID": "benh-vien" },
      "d1_databases": [
        { "binding": "DB", "database_name": "benh-vien-staging", "database_id": "REPLACE_WITH_STAGING_DATABASE_ID", "migrations_dir": "apps/worker/migrations" }
      ],
      "r2_buckets": [{ "binding": "ASSETS_BUCKET", "bucket_name": "benh-vien-assets-staging" }]
    },
    "production": {
      "vars": { "APP_ENV": "production", "AI_GATEWAY_ACCOUNT_ID": "", "AI_GATEWAY_ID": "benh-vien" },
      "d1_databases": [
        { "binding": "DB", "database_name": "benh-vien", "database_id": "REPLACE_WITH_PRODUCTION_DATABASE_ID", "migrations_dir": "apps/worker/migrations" }
      ],
      "r2_buckets": [{ "binding": "ASSETS_BUCKET", "bucket_name": "benh-vien-assets" }]
    }
  }
}
